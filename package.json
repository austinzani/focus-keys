{
	"name": "neo-pomodoro",
	"private": true,
	"description": "Mac-only Stream Deck Neo plugin: whole-minute Pomodoro countdown (working name).",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.austinzani.neo-pomodoro\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"validate": "streamdeck validate com.austinzani.neo-pomodoro.sdPlugin",
		"link": "streamdeck link com.austinzani.neo-pomodoro.sdPlugin",
		"restart": "streamdeck restart com.austinzani.neo-pomodoro"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.6"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.5",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^15.3.1",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"@tsconfig/node24": "^24.0.6",
		"@types/node": "~24.1.0",
		"rollup": "^4.68.8",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"vitest": "^5.1.1"
	}
}
