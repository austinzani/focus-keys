{
	"name": "focus-keys",
	"version": "0.1.6",
	"private": true,
	"license": "MIT",
	"description": "Focus Keys: Mac-only Stream Deck plugin with whole-minute countdown timers.",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.austinzani.focus-keys\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"validate": "streamdeck validate com.austinzani.focus-keys.sdPlugin",
		"link": "streamdeck link com.austinzani.focus-keys.sdPlugin",
		"restart": "streamdeck restart com.austinzani.focus-keys",
		"glyphs": "node scripts/generate-glyphs.mjs",
		"preview": "node scripts/preview.mjs",
		"icons": "node scripts/generate-icons.mjs",
		"notifier": "node scripts/build-notifier.mjs",
		"package": "node scripts/package.mjs"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.6"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.5",
		"@fontsource/bitter": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/nunito": "^5.3.0",
		"@fontsource/oswald": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^15.3.1",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"@tsconfig/node24": "^24.0.6",
		"@types/node": "~24.1.0",
		"opentype.js": "^1.3.4",
		"rollup": "^4.68.8",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
