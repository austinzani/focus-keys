{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Focus Keys",
	"Version": "0.1.0.0",
	"Author": "Austin Zani",
	"Actions": [
		{
			"Name": "Timer Preset",
			"UUID": "com.austinzani.focus-keys.preset",
			"Icon": "imgs/actions/preset/icon",
			"Tooltip": "Tap to start, pause, or resume a whole-minute countdown. Hold to cancel.",
			"PropertyInspectorPath": "ui/preset.html",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/preset/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Break",
			"UUID": "com.austinzani.focus-keys.break",
			"Icon": "imgs/actions/break/icon",
			"Tooltip": "A break timer that never switches Focus. Tap to start, pause, or resume. Hold to cancel.",
			"PropertyInspectorPath": "ui/preset.html",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/break/key",
					"ShowTitle": false
				}
			]
		}
	],
	"Category": "Focus Keys",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "A calm whole-minute countdown for Stream Deck Neo keys. No seconds, just minutes and a progress ring.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.austinzani.focus-keys"
}
